// lib/i18n.ts

export type Locale = "ar" | "fr" | "en"

export const locales: Locale[] = ["ar", "fr", "en"]
export const defaultLocale: Locale = "ar"

export const localeNames: Record<Locale, string> = {
  ar: "العربية",
  fr: "Français",
  en: "English",
}

export const localeDirections: Record<Locale, "rtl" | "ltr"> = {
  ar: "rtl",
  fr: "ltr",
  en: "ltr",
}

export function getDirection(locale: Locale): "rtl" | "ltr" {
  return localeDirections[locale]
}

export function isRTL(locale: Locale): boolean {
  return localeDirections[locale] === "rtl"
}




// lib/i18nJson.ts

export type Locale = "ar" | "en" | "fr"

export function pickI18n(obj: any, locale: Locale) {
  if (!obj) return ""
  return obj?.[locale] || obj?.ar || obj?.en || obj?.fr || ""
}




// lib/news-data.ts

import { supabaseBrowser } from "@/lib/supabaseBrowser"
import { supabaseServer } from "@/lib/supabaseServer"

/* ========= PUBLIC ========= */
export async function getPublishedNews() {
  return supabaseBrowser
    .from("news")
    .select("id, cover_url, published_at, geo_name, title_i18n, excerpt_i18n")
    .eq("status", "published")
    .order("published_at", { ascending: false })
}


export async function getLatestNews(locale: "ar" | "fr" | "en") {
  const supabase = await supabaseServer()
  const { data } = await supabase
    .from("news")
    .select("id, cover_url, published_at, geo_name, title_i18n, excerpt_i18n")
    .eq("status", "published")
    .order("published_at", { ascending: false })
    .limit(3)

  return data || []
}



/* ========= SINGLE NEWS ========= */
export async function getNewsById(id: string | number) {
  return supabaseBrowser
    .from("news")
    .select("*")
    .eq("id", id)
    .single()
}

/* ========= ADMIN ========= */
export async function getAllNewsAdmin() {
  const sb = await supabaseServer()
  return sb.from("news").select("*").order("created_at", { ascending: false })
}

export async function deleteNews(id: number) {
  return supabaseServer.from("news").delete().eq("id", id)
}

export async function createNews(payload: any) {
  return supabaseServer.from("news").insert(payload)
}

export async function updateNews(id: number, payload: any) {
  return supabaseServer.from("news").update(payload).eq("id", id)
}





